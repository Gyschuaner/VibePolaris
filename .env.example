# Server only. Never use NEXT_PUBLIC_ for these values.
DASHSCOPE_API_KEY=
# Copy the OpenAI-compatible Base URL from your Bailian workspace console.
DASHSCOPE_BASE_URL=
XIAOBEI_MODEL=deepseek-v4.1-flash
# Persist this directory when deploying; all app processes must share one DB.
XIAOBEI_DB_PATH=.xiaobei/xiaobei.sqlite
# Set to the app's local listener when using a non-default port.
XIAOBEI_CONTENT_ORIGIN=http://127.0.0.1:3000
# Set the public origin when deploying behind a reverse proxy; leave empty locally.
XIAOBEI_SITE_ORIGIN=
# Legacy Dots GET compatibility only. The primary handoff uses repository_dispatch.
NEWS_DOTS_ENDPOINT=
NEWS_DOTS_TOKEN=
